# LinkMind — variáveis de ambiente (todas têm default; copie p/ .env e ajuste o necessário)
# O .env real é git-ignored. Em produção, exporte no shell/~/.bashrc do host.

# --- Postgres (pgserve) ---
# Conexão é por SOCKET UNIX com trust (não host/porta). jsonb volta como string.
LINKMIND_PG_SOCKET=/run/user/1000/pgserve/.s.PGSQL.5432   # default: $XDG_RUNTIME_DIR/pgserve/.s.PGSQL.5432
LINKMIND_PG_DB=linkmind
LINKMIND_PG_USER=postgres

# --- Omni (canal WhatsApp) ---
# TROCAR pelo seu instance ID (o default no código é o do ambiente de origem).
LINKMIND_OMNI_INSTANCE=05415247-c598-4a2b-832b-f127d4410e10
# Binário do omni — só precisa setar se não estiver no PATH do bridge (~/.bun/bin).
# LINKMIND_OMNI_BIN=/home/lucsb/.bun/bin/omni
# Destino fixo do worker — APENAS para teste headless; em produção o chat é dinâmico.
# LINKMIND_OMNI_TO=72254369050669@lid

# --- Lembretes proativos (revisão espaçada) ---
LINKMIND_REMINDER_DIAS=3   # idade mínima do artigo não-lido + intervalo entre lembretes
LINKMIND_REMINDER_MAX=3    # teto de lembretes por node antes de desistir

# --- Pesquisa web (F1.6 — ainda não ativa) ---
# BRAVE_API_KEY=
